<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.phuthanh.business.controller.HomeBusinessController">
  <!-- TOP TOOLBAR -->
  <VBox spacing="8.0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
    <HBox spacing="10">
      <Label text="Tìm theo:" />
      <ComboBox fx:id="cbSearchColumn" prefWidth="150.0" />
      <TextField fx:id="txtSearch" prefWidth="200.0" promptText="Nhập từ khóa..." />
      <Button fx:id="btnReload" onAction="#onReload" text="Tải lại" />
      <Button fx:id="btnAppendix" onAction="#onOpenAppendix" text="Phụ lục" />
      <Button fx:id="btnExportExcel" onAction="#onExportExcel" text="Xuất Excel" />
      <Button fx:id="btnDetailsProduct" onAction="#onOpenDetailsProduct" text="Bộ/cụm chi tiết" />
      <Button fx:id="btnGuarantee" onAction="#onGuarantee" text="Bảo hành" />
         <Button fx:id="btnSearchMass" mnemonicParsing="false" onAction="#OnSearchMass" text="Tìm kiếm hàng loạt" />
      <StackPane>
        <Button fx:id="btnCart" onAction="#onCart" text="Đơn hàng" />
        <Label fx:id="cartBadge" style="-fx-background-color:red; -fx-text-fill:white; -fx-font-size:10px; -fx-padding:2 6 2 6; -fx-background-radius:10;" text="0" translateX="5" translateY="-5" visible="false" StackPane.alignment="TOP_RIGHT" />
      </StackPane>
      <Button fx:id="btnHistory" onAction="#onHistory" text="Lịch sử FAST" />
    </HBox>
  </VBox>
  <!-- MAIN CONTENT -->
  <TabPane fx:id="tabPane" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="30.0">
    <tabs>
      <Tab fx:id="tabV" closable="false" text="Danh mục hàng hóa">
        <AnchorPane>
          <TableView fx:id="tableView" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" />
        </AnchorPane>
      </Tab>
      <Tab fx:id="tabProductIDMain" closable="false" text="Danh mục sản phẩm mới">
        <AnchorPane>
          <TableView fx:id="tabProductIDMainTable" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" VBox.vgrow="ALWAYS" />
        </AnchorPane>
      </Tab>
    </tabs>
  </TabPane>
</AnchorPane>
