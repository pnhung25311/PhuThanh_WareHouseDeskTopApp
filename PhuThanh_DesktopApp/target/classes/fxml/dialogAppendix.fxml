<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@/css/appendix.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.phuthanh.warehouse.screen.dialog.DialogAppendix">
  <VBox spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
    <!-- Thanh chức năng -->
    <HBox spacing="10">
      <TextField fx:id="txtSearch" promptText="Nhập từ khóa tìm kiếm..." HBox.hgrow="ALWAYS"/>
      <ComboBox fx:id="cbFilter" prefWidth="180"/>
      <!-- CRUD BUTTONS -->
      <Button fx:id="btnCreate" text="Thêm" onAction="#onCreate"/>
      <Button fx:id="btnUpdate" text="Sửa" onAction="#onUpdate"/>
      <Button fx:id="btnDelete" text="Xóa" onAction="#onDelete"/>
    </HBox>
    <!-- Table -->
    <TableView fx:id="tableView" prefHeight="400" VBox.vgrow="ALWAYS"/>
  </VBox>
</AnchorPane>
