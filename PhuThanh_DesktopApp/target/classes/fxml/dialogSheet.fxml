<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.phuthanh.warehouse.screen.dialog.DialogSheet">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- TextField 1 -->
    <VBox spacing="5">
        <Label text="Nhập mã phiếu" />
        <TextField fx:id="txtSheetID" />
    </VBox>

    <!-- TextField 2 -->
    <VBox spacing="5">
        <Label text="Ghi chú" />
        <TextField fx:id="txtRemark" />
    </VBox>

    <!-- Buttons -->
    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="btnSave" onAction="#onSave" text="Lưu" />
        <Button fx:id="btnExit" onAction="#onExit" text="Thoát" />
    </HBox>

</VBox>
