<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.ListView?>

<AnchorPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.phuthanh.drawer.DrawerController"
            fx:id="drawerPane"
            prefWidth="200" prefHeight="400"
            style="-fx-background-color: #2c3e50;"
            stylesheets="@../css/drawer.css">
    <children>
        <ListView fx:id="drawerListView" layoutX="0" layoutY="0" prefWidth="200" prefHeight="400"/>
    </children>
</AnchorPane>
