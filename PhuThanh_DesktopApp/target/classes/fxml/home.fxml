<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXHamburger?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.phuthanh.warehouse.controller.HomeController">
  <!-- Nội dung chính -->
  <VBox AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
    <children>
      <!-- Thanh tìm kiếm -->
      <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-bar">
        <children>
          <JFXHamburger fx:id="hamburger" />
          <Label fx:id="btnUpdate" text="Tìm kiếm:" />
          <ComboBox fx:id="cbbSearch" />
          <TextField fx:id="txtSearch" prefHeight="25.0" prefWidth="200.0" promptText="Nhập từ khóa..." />
          <Button fx:id="btnSearch" onAction="#onSearch" text="Tìm" />
          <Button fx:id="btnReload" onAction="#onReload" text="Tải lại" />
          <Button fx:id="btnAppendix" mnemonicParsing="false" onAction="#onOpenAppendix" text="Phụ lục" />
          <Button fx:id="btnCreate" onAction="#onCreateClick" text="Thêm mới" />
          <Button fx:id="btnExportExcel" mnemonicParsing="false" onAction="#onExportExcel" text="Xuất Excel" />
          <Button fx:id="btnImportExcel" mnemonicParsing="false" onAction="#ImportExcel" text="Nhập Excel" />
               <Button fx:id="btnImportTableView" mnemonicParsing="false" onAction="#ImportTableView" text="Nhập liệu" />
          <Button fx:id="btnDetailsProduct" mnemonicParsing="false" onAction="#onOpenDetailsProduct" text="Bộ/cụm chi tiết" />
          <Button fx:id="btnGuarantee" mnemonicParsing="false" onAction="#onGuarantee" text="Bảo hành" />
          <Button fx:id="btnChart" mnemonicParsing="false" onAction="#onOpenChart" text="Thống kê" />
          <StackPane>
            <Button fx:id="btnCart" onAction="#onCart" text="Đơn hàng" />
            <Label fx:id="cartBadge" style="-fx-background-color: red; -fx-text-fill: white;-fx-font-size: 10px;-fx-padding: 2 6 2 6;-fx-background-radius: 10;" text="0" translateX="5" translateY="-5" visible="false" StackPane.alignment="TOP_RIGHT" />
          </StackPane>
          <Button fx:id="btnHistory" mnemonicParsing="false" onAction="#onOpenHistory" text="Lịch sử" />
          <Button fx:id="btnCheckSheet" mnemonicParsing="false" onAction="#onCheckSheet" text="Kiểm kho" />
        </children>
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
      </HBox>
      <!-- TabPane -->
      <TabPane fx:id="jtable" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
          <Tab fx:id="tabInformation" text="Thông tin">
            <content>
              <TableView fx:id="tabInformationTable" VBox.vgrow="ALWAYS" />
            </content>
          </Tab>
               <Tab fx:id="tabProductIDMain" text="Danh mục sản phẩm mới">
                  <content>
                     <TableView fx:id="tabProductIDMainTable" VBox.vgrow="ALWAYS" />
                  </content>
               </Tab>
          <Tab fx:id="tabDetails" text="Lịch sử">
            <content>
              <TableView fx:id="tabDetailTable" VBox.vgrow="ALWAYS" />
            </content>
          </Tab>
          <Tab fx:id="tabRequest" text="Yêu cầu">
            <content>
              <TableView fx:id="tabRequestTable" VBox.vgrow="ALWAYS" />
            </content>
          </Tab>
        </tabs>
      </TabPane>
    </children>
  </VBox>
  <!-- Overlay -->
  <AnchorPane fx:id="overlay" mouseTransparent="true" styleClass="overlay" visible="false" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" />
  <!-- Drawer -->
  <fx:include fx:id="drawer" source="drawer.fxml" styleClass="drawer-pane" />
</AnchorPane>
