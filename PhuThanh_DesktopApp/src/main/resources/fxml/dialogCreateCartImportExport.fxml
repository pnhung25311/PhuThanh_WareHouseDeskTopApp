<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" style="-fx-padding: 0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.phuthanh.warehouse.screen.dialog.DialogCreateCartImportExport">

    <!-- ===== THÔNG TIN CHUNG ===== -->
    <GridPane hgap="10" style="-fx-padding: 15; -fx-background-color: #f0f4ff;                      -fx-border-color: #b0c4de; -fx-border-width: 0 0 2 0;" vgap="10">
        <columnConstraints>
            <ColumnConstraints maxWidth="170" minWidth="130" prefWidth="145" />
            <ColumnConstraints fillWidth="true" hgrow="ALWAYS" maxWidth="260" minWidth="150" prefWidth="210" />
            <ColumnConstraints maxWidth="160" minWidth="100" prefWidth="130" />
            <ColumnConstraints fillWidth="true" hgrow="ALWAYS" maxWidth="260" minWidth="150" prefWidth="210" />
            <ColumnConstraints maxWidth="140" minWidth="80" prefWidth="110" />
            <ColumnConstraints fillWidth="true" hgrow="ALWAYS" maxWidth="260" minWidth="150" prefWidth="210" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints prefHeight="32" />
            <RowConstraints prefHeight="32" />
            <RowConstraints prefHeight="32" />
        </rowConstraints>

        <Label style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #2c5f9e;" text="— THÔNG TIN CHUNG —" GridPane.columnSpan="6" GridPane.halignment="CENTER" />

        <Label text="Mã sản phẩm thực tế*:" GridPane.rowIndex="1" GridPane.valignment="CENTER" />
        <TextField fx:id="txtProductID" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="Danh điểm:" GridPane.columnIndex="2" GridPane.rowIndex="1" GridPane.valignment="CENTER" />
        <TextField fx:id="txtPartNo" prefWidth="200" GridPane.columnIndex="3" GridPane.rowIndex="1" />
        <Label text="Tên sản phẩm*:" GridPane.columnIndex="4" GridPane.rowIndex="1" GridPane.valignment="CENTER" />
        <TextField fx:id="txtNameProduct" prefWidth="200" GridPane.columnIndex="5" GridPane.rowIndex="1" />

        <Label text="Hãng SX:" GridPane.rowIndex="2" GridPane.valignment="CENTER" />
        <ComboBox fx:id="ManufacturerID" prefHeight="25" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label text="Nước SX:" GridPane.columnIndex="2" GridPane.rowIndex="2" GridPane.valignment="CENTER" />
        <ComboBox fx:id="CountryID" prefHeight="25" prefWidth="200" GridPane.columnIndex="3" GridPane.rowIndex="2" />
        <Label text="ĐVT*:" GridPane.columnIndex="4" GridPane.rowIndex="2" GridPane.valignment="CENTER" />
        <ComboBox fx:id="UnitID" prefHeight="25" prefWidth="200" GridPane.columnIndex="5" GridPane.rowIndex="2" />
    </GridPane>

    <!-- ===== HÃNG XE ===== -->
    <GridPane hgap="10" style="-fx-padding: 10 15 10 15; -fx-background-color: #f0f4ff;                      -fx-border-color: #b0c4de; -fx-border-width: 0 0 2 0;" vgap="10">
        <columnConstraints>
            <ColumnConstraints maxWidth="170" minWidth="130" prefWidth="145" />
            <ColumnConstraints fillWidth="true" hgrow="ALWAYS" maxWidth="400" minWidth="150" prefWidth="330" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints prefHeight="32" />
        </rowConstraints>
        <Label text="Hãng xe:" GridPane.valignment="CENTER" />
        <HBox spacing="10" GridPane.columnIndex="1">
            <TextField fx:id="txtVehicelID" alignment="CENTER" editable="false" prefWidth="200" />
            <Button fx:id="btnVehicelID" onAction="#onVehicelID" prefHeight="25" prefWidth="110" text="Chọn hãng xe" />
        </HBox>
    </GridPane>

    <!-- ===== SCROLL PANE ===== -->
    <ScrollPane fitToWidth="true" style="-fx-padding: 0;" VBox.vgrow="ALWAYS">
        <content>
            <VBox spacing="0">

                <!--
                ╔══════════════════════════╦══════════════════════════╗
                ║       PHIẾU XUẤT         ║       PHIẾU NHẬP         ║
                ╚══════════════════════════╩══════════════════════════╝
                Hai GridPane đặt trong HBox, mỗi GridPane chiếm 50% chiều rộng.
                Số dòng và prefHeight của từng dòng phải BẰNG NHAU để nội dung
                căn đều theo chiều ngang.
                -->
                <HBox spacing="0">

                    <!-- ══════════ CỘT TRÁI: PHIẾU XUẤT ══════════ -->
                    <GridPane hgap="10" style="-fx-padding: 15; -fx-background-color: #fff8f8;                                      -fx-border-color: #dda0a0; -fx-border-width: 0 1 0 0;" vgap="8" HBox.hgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints maxWidth="210" minWidth="145" prefWidth="170" />
                            <ColumnConstraints fillWidth="true" hgrow="ALWAYS" minWidth="120" prefWidth="185" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints prefHeight="32" />   <!-- 0  tiêu đề -->
                            <RowConstraints prefHeight="32" />   <!-- 1  số lượng -->
                            <RowConstraints prefHeight="32" />   <!-- 2  đơn giá -->
                            <RowConstraints prefHeight="32" />   <!-- 3  thành tiền -->
                            <RowConstraints prefHeight="32" />   <!-- 4  giá VAT -->
                            <RowConstraints prefHeight="32" />   <!-- 5  giá mua tham chiếu -->
                            <RowConstraints prefHeight="32" />   <!-- 6  đơn vị bán hàng -->
                            <RowConstraints prefHeight="32" />   <!-- 7  mã SP VAT -->
                            <RowConstraints prefHeight="32" />   <!-- 8  nơi lấy hàng -->
                            <RowConstraints prefHeight="32" />   <!-- 9  nơi nhận hàng -->
                            <RowConstraints prefHeight="32" />   <!-- 10 ngày giao -->
                            <RowConstraints prefHeight="32" />   <!-- 11 nhân viên -->
                            <RowConstraints prefHeight="32" />   <!-- 12 hóa đơn -->
                            <RowConstraints prefHeight="32" />   <!-- 13 thanh toán -->
                            <RowConstraints prefHeight="32" />   <!-- 14 (trống - cân bằng với cột nhập) -->
                            <RowConstraints prefHeight="32" />   <!-- 15 (trống) -->
                            <RowConstraints prefHeight="96" />   <!-- 16 ghi chú -->
                        </rowConstraints>

                        <Label style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #8b0000;" text="— PHIẾU NHẬP —" GridPane.columnSpan="2" GridPane.halignment="CENTER" GridPane.rowIndex="0" />

                        <Label text="Số lượng*:" GridPane.rowIndex="1" GridPane.valignment="CENTER" />
                        <TextField fx:id="txtQty" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Đơn giá NET:" GridPane.rowIndex="2" GridPane.valignment="CENTER" />
                        <TextField fx:id="txtPriceNET" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Thành tiền:" GridPane.rowIndex="3" GridPane.valignment="CENTER" />
                        <TextField fx:id="txtTotal" editable="false" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Giá VAT:" GridPane.rowIndex="4" GridPane.valignment="CENTER" />
                        <TextField fx:id="txtPriceVAT" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label text="Giá mua tham chiếu:" GridPane.rowIndex="5" GridPane.valignment="CENTER" />
                        <TextField fx:id="txtCogs" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                        <Label text="Nhập về đơn vị nào*:" GridPane.rowIndex="6" GridPane.valignment="CENTER" />
                        <ComboBox fx:id="BusinessID" maxWidth="Infinity" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                        <Label text="Mã sản phẩm VAT:" GridPane.rowIndex="7" GridPane.valignment="CENTER" />
                        <TextField fx:id="txtProductIDVAT" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                        <Label text="Nơi lấy hàng*:" GridPane.rowIndex="8" GridPane.valignment="CENTER" />
                        <ComboBox fx:id="SourceID" maxWidth="Infinity" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="8" />

                        <Label text="Nơi nhận hàng*:" GridPane.rowIndex="9" GridPane.valignment="CENTER" />
                        <ComboBox fx:id="DeliveryID" maxWidth="Infinity" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="9" />

                        <Label fx:id="lblDeliveryTime" text="Ngày nhập*:" GridPane.rowIndex="10" GridPane.valignment="CENTER" />
                        <DatePicker fx:id="txtDeliveryTime" maxWidth="Infinity" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="10" />

                        <Label text="Nhân viên:" GridPane.rowIndex="11" GridPane.valignment="CENTER" />
                        <ComboBox fx:id="EmployeeID" maxWidth="Infinity" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="11" />

                        <Label text="Hóa đơn*:" GridPane.rowIndex="12" GridPane.valignment="CENTER" />
                        <ComboBox fx:id="BillID" maxWidth="Infinity" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="12" />

                        <Label text="Tình trạng thanh toán:" GridPane.rowIndex="13" GridPane.valignment="CENTER" />
                        <ComboBox fx:id="PaymentID" maxWidth="Infinity" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="13" />

                        <!-- dòng 14, 15 để trống cân bằng với phiếu nhập (hợp đồng + trạng thái VAT) -->

                        <Label text="Ghi chú:" GridPane.rowIndex="16" GridPane.valignment="TOP" />
                        <TextArea fx:id="txtRemark" maxWidth="Infinity" prefHeight="80" GridPane.columnIndex="1" GridPane.rowIndex="16" />
                    </GridPane>

                    <!-- ══════════ CỘT PHẢI: PHIẾU NHẬP ══════════ -->
                    <GridPane hgap="10" style="-fx-padding: 15; -fx-background-color: #f8fff8;" vgap="8" HBox.hgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints maxWidth="210" minWidth="145" prefWidth="170" />
                            <ColumnConstraints fillWidth="true" hgrow="ALWAYS" minWidth="120" prefWidth="185" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints prefHeight="32" />   <!-- 0  tiêu đề -->
                            <RowConstraints prefHeight="32" />   <!-- 1  số lượng -->
                            <RowConstraints prefHeight="32" />   <!-- 2  đơn giá -->
                            <RowConstraints prefHeight="32" />   <!-- 3  thành tiền -->
                            <RowConstraints prefHeight="32" />   <!-- 4  giá VAT -->
                            <RowConstraints prefHeight="32" />   <!-- 5  giá mua tham chiếu -->
                            <RowConstraints prefHeight="32" />   <!-- 6  đơn vị bán hàng -->
                            <RowConstraints prefHeight="32" />   <!-- 7  mã SP VAT -->
                            <RowConstraints prefHeight="32" />   <!-- 8  nơi lấy hàng -->
                            <RowConstraints prefHeight="32" />   <!-- 9  nơi nhận hàng -->
                            <RowConstraints prefHeight="32" />   <!-- 10 ngày nhập -->
                            <RowConstraints prefHeight="32" />   <!-- 11 nhân viên -->
                            <RowConstraints prefHeight="32" />   <!-- 12 hóa đơn nhập -->
                            <RowConstraints prefHeight="32" />   <!-- 13 tình trạng thanh toán -->
                            <RowConstraints prefHeight="32" />   <!-- 14 trạng thái VAT -->
                            <RowConstraints prefHeight="32" />   <!-- 15 hợp đồng -->
                            <RowConstraints prefHeight="96" />   <!-- 16 ghi chú -->
                        </rowConstraints>

                        <Label style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #1a6b1a;" text="— PHIẾU XUẤT —" GridPane.columnSpan="2" GridPane.halignment="CENTER" GridPane.rowIndex="0" />

                        <Label text="Số lượng nhập*:" GridPane.rowIndex="1" GridPane.valignment="CENTER" />
                        <TextField fx:id="txtImportQty" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Đơn giá NET:" GridPane.rowIndex="2" GridPane.valignment="CENTER" />
                        <TextField fx:id="txtImportPrice" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Thành tiền:" GridPane.rowIndex="3" GridPane.valignment="CENTER" />
                        <TextField fx:id="txtImportTotal" editable="false" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Giá VAT:" GridPane.rowIndex="4" GridPane.valignment="CENTER" />
                        <TextField fx:id="txtImportPriceVAT" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label text="Giá mua tham chiếu:" GridPane.rowIndex="5" GridPane.valignment="CENTER" />
                        <TextField fx:id="txtImportCogs" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                        <Label text="Đơn vị bán hàng trực tếp*:" GridPane.rowIndex="6" GridPane.valignment="CENTER" />
                        <ComboBox fx:id="ImportBusinessID" maxWidth="Infinity" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                        <Label text="Mã sản phẩm VAT:" GridPane.rowIndex="7" GridPane.valignment="CENTER" />
                        <TextField fx:id="txtImportProductIDVAT" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                        <Label text="Nơi lấy hàng*:" GridPane.rowIndex="8" GridPane.valignment="CENTER" />
                        <ComboBox fx:id="ImportSourceID" maxWidth="Infinity" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="8" />

                        <Label text="Nơi nhận hàng*:" GridPane.rowIndex="9" GridPane.valignment="CENTER" />
                        <ComboBox fx:id="ImportDeliveryID" maxWidth="Infinity" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="9" />

                        <Label text="Ngày giao*:" GridPane.rowIndex="10" GridPane.valignment="CENTER" />
                        <DatePicker fx:id="txtImportDate" maxWidth="Infinity" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="10" />

                        <Label text="Nhân viên:" GridPane.rowIndex="11" GridPane.valignment="CENTER" />
                        <ComboBox fx:id="ImportEmployeeID" maxWidth="Infinity" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="11" />

                        <Label text="Hóa đơn*:" GridPane.rowIndex="12" GridPane.valignment="CENTER" />
                        <ComboBox fx:id="ImportBillID" maxWidth="Infinity" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="12" />

                        <Label text="Tình trạng thanh toán:" GridPane.rowIndex="13" GridPane.valignment="CENTER" />
                        <ComboBox fx:id="ImportPaymentID" maxWidth="Infinity" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="13" />

                        <Label text="Trạng thái VAT:" GridPane.rowIndex="14" GridPane.valignment="CENTER" />
                        <ComboBox fx:id="ImportStatusVAT" maxWidth="Infinity" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="14" />

                        <Label text="Hợp đồng:" GridPane.rowIndex="15" GridPane.valignment="CENTER" />
                        <TextField fx:id="txtImportContractID" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="15" />

                        <Label text="Ghi chú:" GridPane.rowIndex="16" GridPane.valignment="TOP" />
                        <TextArea fx:id="txtImportRemark" maxWidth="Infinity" prefHeight="80" GridPane.columnIndex="1" GridPane.rowIndex="16" />
                    </GridPane>

                </HBox>

                <!-- ===== NÚT LƯU / THOÁT ===== -->
                <HBox alignment="CENTER" spacing="10" style="-fx-padding: 15;">
                    <Button fx:id="btnSave" onAction="#onSave" prefHeight="34" prefWidth="150" text="Lưu thông tin" />
                    <Button fx:id="btnCancel" onAction="#onCloseClick" prefHeight="34" prefWidth="120" text="Thoát" />
                </HBox>

            </VBox>
        </content>
    </ScrollPane>

</VBox>
